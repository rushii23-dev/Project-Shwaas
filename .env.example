# Copy to .env.local and fill in. Everything here is bundled into the browser
# build, so ONLY use keys that are safe to be public once restricted:
#
# Gemini: create a key at https://aistudio.google.com/app/apikey, then in
# Google Cloud Console -> APIs & Services -> Credentials, restrict it to
#   - Application restriction: HTTP referrers -> https://your-site.vercel.app/*
#   - API restriction: Generative Language API only
# Without a key the app still works: it falls back to the built-in rule-based
# planner, and users can paste their own key in Settings.
VITE_GEMINI_API_KEY=

# Optional. Model id for the assistant.
VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional. WAQI token (https://aqicn.org/data-platform/token/) adds the nearest
# official monitoring station's reading next to the Open-Meteo model value.
VITE_WAQI_TOKEN=
